# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.
# docker compose loads ".env" automatically - no extra flag needed.
# ".env" is gitignored: never commit real secrets.

# --- Database ---
DB_USER=timetracker
DB_PASSWORD=change_me_to_a_strong_password

# --- JWT signing secret ---
# Any long random string (32+ characters). Used to sign/verify login tokens.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string

# How many days the mobile app stays signed in without being opened. Each time it's opened the
# count starts over. Lower it for stricter security; it can't be below 1.
JWT_REFRESH_TOKEN_DAYS=14

# --- Bootstrap platform admin account ---
# Created once, automatically, the first time the app starts without any platform admin.
# A platform admin creates companies (each with its first employer account) and other
# platform admins; there is no public sign-up. Leave these blank and nobody will be able
# to log in until you set them and restart.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=change_me_then_change_it_again_after_first_login
SEED_ADMIN_FIRST_NAME=Jane
SEED_ADMIN_LAST_NAME=Admin

# --- Outgoing email ---
# The address people open the app at, e.g. https://hours.example.com. Leave emails then get
# Approve and Reject buttons that open the request in the app. Leave it blank and the email
# just says to open the app.
APP_URL=
# Companies can only send through mail servers on the internet by default, so an employer
# can't point the SMTP host at services inside this server's network. Set to true if your
# mail server is on your own network (e.g. 192.168.x.x or another container).
EMAIL_ALLOW_INTERNAL_HOSTS=false

# --- Webhooks ---
# Webhooks may only call public addresses by default. Set to true if a receiver runs on your
# own network (e.g. your own n8n at 192.168.x.x or in another container).
WEBHOOK_ALLOW_INTERNAL_HOSTS=false
