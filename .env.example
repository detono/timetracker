# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.
# docker compose loads ".env" automatically - no extra flag needed.
# ".env" is gitignored: never commit real secrets.

# --- Database ---
DB_USER=timetracker
DB_PASSWORD=change_me_to_a_strong_password

# --- JWT signing secret ---
# Any long random string (32+ characters). Used to sign/verify login tokens.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string

# --- Bootstrap employer account ---
# Created once, automatically, the first time the app starts against an empty database.
# There is no public sign-up (account creation is Employer-only), so this is how you get
# your first account. Leave these blank and the app starts with zero users - nobody will
# be able to log in until you set them and restart.
SEED_EMPLOYER_EMAIL=owner@yourcompany.com
SEED_EMPLOYER_PASSWORD=change_me_then_change_it_again_after_first_login
SEED_EMPLOYER_FIRST_NAME=Jane
SEED_EMPLOYER_LAST_NAME=Owner
