# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.
# docker compose loads ".env" automatically - no extra flag needed.
# ".env" is gitignored: never commit real secrets.

# --- Database ---
DB_USER=timetracker
DB_PASSWORD=change_me_to_a_strong_password

# --- JWT signing secret ---
# Any long random string (32+ characters). Used to sign/verify login tokens.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string

# --- Bootstrap platform admin account ---
# Created once, automatically, the first time the app starts without any platform admin.
# A platform admin creates companies (each with its first employer account) and other
# platform admins; there is no public sign-up. Leave these blank and nobody will be able
# to log in until you set them and restart.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=change_me_then_change_it_again_after_first_login
SEED_ADMIN_FIRST_NAME=Jane
SEED_ADMIN_LAST_NAME=Admin
